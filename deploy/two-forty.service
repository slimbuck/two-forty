[Unit]
Description=Two Forty CRT game host
After=local-fs.target

[Service]
Type=simple
User=retro
Group=retro
SupplementaryGroups=video render input audio
WorkingDirectory=/home/retro/two-forty
ExecStart=/home/retro/two-forty/build/two-forty-host
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
StandardOutput=append:/home/retro/two-forty/run/two-forty.log
StandardError=append:/home/retro/two-forty/run/two-forty.log

[Install]
WantedBy=multi-user.target
